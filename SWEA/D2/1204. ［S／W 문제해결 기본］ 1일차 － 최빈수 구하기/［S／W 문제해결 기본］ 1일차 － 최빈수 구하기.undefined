import java.io.BufferedReader;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = null;

        int T = Integer.parseInt(br.readLine());

        for (int i = 0; i < T; i++) {
            int testNumber = Integer.parseInt(br.readLine());

            int[] students = new int[101]; //점수를 배열로 만들어두기

            st = new StringTokenizer(br.readLine());
            //일단 점수들 집어넣고
            for (int j = 0; j < 1000; j++) {
                int scoreNum = Integer.parseInt(st.nextToken());

                students[scoreNum] += 1;
            }

            int currentMaxScore = 0; //현재최고점수
            int currentMaxScoreStudentCount = 0; //학생수가 가장 많은 수
            for (int currentScore = 0; currentScore < 101; currentScore++) {
                if (currentMaxScoreStudentCount <= students[currentScore]) {
                    currentMaxScoreStudentCount = students[currentScore];
                    currentMaxScore = currentScore;
                }
            }

            System.out.println("#" + testNumber + " " + currentMaxScore);
        }
    }
}
